 "font_size": 14,
 "html": "<style>\n    .mm-report-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 15px;\n    }\n    .mm-report-table th, .mm-report-table td {\n        border: 1px solid #ddd;\n        padding: 6px 8px;\n        font-size: 13px;\n    }\n    .mm-report-table th {\n        background: #f5f5f5;\n        font-weight: bold;\n    }\n    .mm-total-row {\n        background: #f0f8ff;\n        font-weight: bold;\n    }\n    .mm-heading {\n        margin-top: 10px;\n        font-size: 16px;\n        font-weight: bold;\n    }\n</style>\n\n\n<div class=\"mm-heading\">Machine Maintenance Consolidated Report</div>\n\n<p>\n    <b>Company:</b> {{ frappe.get_doc(\"Global Defaults\").default_company }} <br>\n\n    {% if filters.machine_name %}\n    <b>Machine:</b> {{ filters.machine_name }} <br>\n    {% endif %}\n\n    {% if filters.technician %}\n    <b>Technician:</b> {{ filters.technician }} <br>\n    {% endif %}\n\n    {% if filters.from_date %}\n    <b>From Date:</b> {{ filters.from_date }} <br>\n    {% endif %}\n\n    {% if filters.to_date %}\n    <b>To Date:</b> {{ filters.to_date }} <br>\n    {% endif %}\n</p>\n\n\n<table class=\"mm-report-table\">\n    <thead>\n        <tr>\n            <th>Machine</th>\n            <th>Total Cost</th>\n            <th>Count</th>\n        </tr>\n    </thead>\n\n    <tbody>\n        {% set grand_total = 0 %}\n\n        {% for row in data %}\n        <tr>\n            <td>{{ row.machine_name }}</td>\n            <td>{{ row.total_cost }}</td>\n            <td>{{ row.count }}</td>\n        </tr>\n        {% set grand_total = grand_total + row.total_cost %}\n        {% endfor %}\n    </tbody>\n\n    <tfoot>\n        <tr class=\"mm-total-row\">\n            <td><b>Grand Total</b></td>\n            <td><b>{{ grand_total }}</b></td>\n            <td></td>\n        </tr>\n    </tfoot>\n</table>\n",
