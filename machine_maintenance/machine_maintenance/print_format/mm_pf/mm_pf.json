 "font_size": 14,
 "html": "<style>\n    .mm-title {\n        font-size: 20px;\n        font-weight: bold;\n        margin-bottom: 10px;\n        border-bottom: 2px solid #444;\n        padding-bottom: 5px;\n    }\n\n    .mm-filter-box {\n        margin-bottom: 10px;\n        font-size: 13px;\n    }\n\n    table.mm-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 10px;\n    }\n\n    table.mm-table th,\n    table.mm-table td {\n        border: 1px solid #ccc;\n        padding: 6px 8px;\n    }\n\n    table.mm-table th {\n        background: #f5f5f5;\n        font-weight: bold;\n    }\n\n    .mm-total-row {\n        background: #e9f5ff;\n        font-weight: bold;\n    }\n</style>\n\n<div class=\"mm-title\">Machine Maintenance - Consolidated Report</div>\n\n<div class=\"mm-filter-box\">\n    <b>Company:</b> {{ frappe.db.get_single_value(\"Global Defaults\", \"default_company\") }} <br>\n\n    {% if filters.machine_name %}\n    <b>Machine:</b> {{ filters.machine_name }} <br>\n    {% endif %}\n\n    {% if filters.technician %}\n    <b>Technician:</b> {{ filters.technician }} <br>\n    {% endif %}\n\n    {% if filters.from_date %}\n    <b>From Date:</b> {{ filters.from_date }} <br>\n    {% endif %}\n\n    {% if filters.to_date %}\n    <b>To Date:</b> {{ filters.to_date }} <br>\n    {% endif %}\n</div>\n\n<table class=\"mm-table\">\n    <thead>\n        <tr>\n            <th>Machine</th>\n            <th>Total Cost</th>\n            <th>Count</th>\n        </tr>\n    </thead>\n\n    <tbody>\n        {% set grand_total = 0 %}\n        {% set grand_count = 0 %}\n\n        {% for row in data %}\n        <tr>\n            <td>{{ row.machine_name }}</td>\n            <td>{{ row.total_cost }}</td>\n            <td>{{ row.count }}</td>\n        </tr>\n\n        {% set grand_total = grand_total + row.total_cost %}\n        {% set grand_count = grand_count + row.count %}\n        {% endfor %}\n    </tbody>\n\n    <tfoot>\n        <tr class=\"mm-total-row\">\n            <td><b>Grand Total</b></td>\n            <td><b>{{ grand_total }}</b></td>\n            <td><b>{{ grand_count }}</b></td>\n        </tr>\n    </tfoot>\n</table>\n",
